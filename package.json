{
  "name": "triangle-games",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "node --test --test-force-exit 'tests/**/*.test.js'",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary node --test --test-force-exit 'tests/**/*.test.js'",
    "coverage:check": "c8 --reporter=text --reporter=lcov --reporter=json-summary --check-coverage node --test --test-force-exit 'tests/**/*.test.js'"
  },
  "keywords": [],
  "author": "Triangle Games",
  "license": "ISC",
  "description": "Simple, fun, mobile-accessible web games",
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "connect-sqlite3": "^0.9.16",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ws": "^8.20.0"
  }
}
